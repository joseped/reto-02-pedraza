# Obligatoria para el chat (no para demo.ts). Nunca la subas al repositorio.
ANTHROPIC_API_KEY=

# Opcionales (valores por defecto entre paréntesis)
# anthropic (por defecto) | simulado = guion determinista sin clave, para QA
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
LLM_TIMEOUT_MS=90000
MAX_ITERACIONES=25
MAX_TOKENS_SESION=400000
PORT=3000
# Fecha de referencia para fecha_registro (vacío = fecha del sistema)
FECHA_HOY=
# Si se define, el front pide esta clave para usar el chat
ACCESS_KEY=
